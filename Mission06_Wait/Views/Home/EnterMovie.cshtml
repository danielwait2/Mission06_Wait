@{
ViewData["Title"] = "Enter a Movie";
}

@model MovieSubmission
<h1>@ViewData["Title"]</h1>

 @* made a basic form *@
 <form method="post">
     
     <input asp-for="MovieId" hidden></input>
     
     <label asp-for="Title">Title (required):</label>
     <input asp-for="Title" required><br><br>

     <label asp-for="Director">Director :</label>
     <input asp-for="Director"><br><br>

     <label asp-for="Year">Year (required):</label>
     <input asp-for="Year" type="number" min="1888" required><br><br>

     <label asp-for="Rating">Rating:</label>
     <select asp-for="Rating">
         <option value="">Select Rating</option>
         <option value="G">G</option>
         <option value="PG">PG</option>
         <option value="PG-13">PG-13</option>
         <option value="R">R</option>
     </select><br><br>

     <label asp-for="CategoryId">Category</label>
     <select asp-for="CategoryId">
         <option value="">Select Category</option>
         @foreach (Categories c in ViewBag.Categories)
         {
             <option value="@c.CategoryId">@c.CategoryName</option>
         }
     </select><br/><br/>

     <label asp-for="Edited">Edited:</label>
     <input asp-for="Edited" type="radio" name="edited" value="true"> Yes
     <input asp-for="Edited" type="radio" name="edited" value="false" checked> No <br><br>

     <label asp-for="LentTo">Lent To:</label>
     <input asp-for="LentTo"><br><br>

     <label asp-for="CopiedToPlex">Copied To Plex:</label>
     <input asp-for="CopiedToPlex" type="radio" name="CopiedToPlex" value="true"> Yes
     <input asp-for="CopiedToPlex" type="radio" name="CopiedToPlex" value="false" checked> No <br><br>

     <label asp-for="Notes">Notes (max 25 chars):</label>
     <input asp-for="Notes" maxlength="25"><br><br>

     <button type="submit">Submit</button>

     <div asp-validation-summary="All"></div>
 </form>